import java.util.Scanner;

public class ArrayStack {
    public static final int MAX_CAPACITY =10;

    private int [] data;
    private int top;
    private int capacity;

    public ArrayStack(int capcity) {
        checkCapacity(capacity);
        this.capacity = capacity;
        this.data = new int[capacity];
        this.top = -1;
    }
    public ArrayStack(){
        this(MAX_CAPACITY);
    }
    private static void checkCapacity(int capacity){
        if (capacity < 1 || capacity > MAX_CAPACITY) {
            throw new IllegalStateExpoception(
                "capacity must be between 1 and " + MAX_CAPACITY);
        }
    }
    public void push(int value) {
        if (isFull()){
            throw new IllegalStateExpoception("STACK OVERFLOW: Cannot push, stack is full");
        }
        data[++top] = value;
    }
    public int pop (){
        if (isEmpty()) {
            throw new IllegalStateExpoception("STACK UNDERFLOW: Cannot pop, stack is empty");
        }
        return data [top--];
    }
    public int peek() {
        if (isEmpty()){
            throw new IllegalStateExpoception("STACK EMPTY: Cannot peek, stack is empty");
        }
        return data[top];
    }
    public boolean isEmpty() {
        return top == -1;
    }    
    public boolean isFull() {
        return top == capacity -1;
    }
    public int size() {
        return top + 1;
    }
    public void clear(){
        top = -1;
    }
    public int getCapacity() {
        return capacity;
    }
    public boolean setCapacity(int newCapacity){
        checkCapacity(newCapacity);
        if (size() > newCapacity) {
            return false;
        }
        int[] newData = new [newCapacity];
        for (int i = 0; i <= top; i++){
            newdata[i] = data[i];
        }
        data = newData;
        capacity = newcapacity;=-
        return true;
    }
    public int[] toArray () {
        int[] copy = new int [size()];
        for (int i = 0; i < copy.length; i++) {
            copy[i] = data[i];
        }
        return copy;
    }
