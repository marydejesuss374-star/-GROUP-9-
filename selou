// PUSH button
pushButton.addActionListener(e -> {
    String item = input.getText().trim();

    if (item.isEmpty()) {
        status.setText("Enter an item first!");
    } else if (top == stack.length - 1) {
        status.setText("Stack is full!");
    } else {
        stack[++top] = item;
        input.setText("");
        status.setText("Pushed: " + item);
        updateStack();
    }
});





// POP button
popButton.addActionListener(e -> {
    if (top == -1) {
        status.setText("Stack is empty!");
    } else {
        String item = stack[top];
        stack[top--] = null;
        status.setText("Popped: " + item);
        updateStack();
    }
});




// PEEK button
peekButton.addActionListener(e -> {
    if (top == -1) {
        status.setText("Stack is empty!");
    } else {
        status.setText("Top item: " + stack[top]);
    }
});
